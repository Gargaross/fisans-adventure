{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Godot: Open Editor",
            "type": "shell",
            "command": "${config:godotTools.editorPath.godot4}",
            "args": ["--editor", "--path", "${workspaceFolder}"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Godot: Run Project",
            "type": "shell",
            "command": "${config:godotTools.editorPath.godot4}",
            "args": ["--path", "${workspaceFolder}"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
